{
	"compilerOptions": {
		"target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
		"declaration": true,
		"outDir": "./lib",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"jsx": "react-jsx"
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules"
	]
}
